# IRIS CRM — Environment Configuration
# Copy this file to .env and fill in the values.
# To use .env files with React Native, install react-native-config:
#   npm install react-native-config
#   then follow native linking instructions for iOS (pod install) and Android (build.gradle).
# Currently, the API base URL is configured in src/app/config/env.ts using __DEV__ + Platform.OS.

# Production API base URL (e.g. https://api.yourdomain.com/api/v1)
API_BASE_URL=http://localhost:3000/api/v1
